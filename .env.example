# Hugging Face token
HF_TOKEN=

# MiniMax H3 Ultra Fast Space
HF_SPACE_ID=mrfakename/minimax-h3-ultra-fast

# Public H3 Space max = 14 seconds
H3_DURATION=14

# 8 = recommended balance
# 4 = lower quota usage / faster
H3_STEPS=8

# Retry settings
MAX_RETRIES=4
RETRY_BASE_SECONDS=15

# Railway public URL
# Example:
# https://your-worker-production.up.railway.app
PUBLIC_BASE_URL=

# Temporary Railway filesystem
OUTPUT_DIR=/tmp/h3-output
